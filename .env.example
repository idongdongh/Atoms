# Copy to .env on the server and fill in real values. Never commit .env.

# --- Public address (required) ----------------------------------------------
# What browsers type in. Without a domain use the server IP over plain HTTP:
ATOMS_SITE_ADDRESS=http://203.0.113.10
# With a domain later: set the bare hostname (e.g. build.example.top) and
# add an `email` block to the top of the Caddyfile for automatic HTTPS.
# ACME_EMAIL=you@example.com

# --- Model (required unless running the offline demo model) ---------------
# Anything other than "demo" uses the OpenAI-compatible provider.
# DeepSeek example:
ATOMS_MODEL_PROVIDER=openai
ATOMS_MODEL_BASE_URL=https://api.deepseek.com/v1
ATOMS_MODEL_NAME=deepseek-chat
ATOMS_MODEL_API_KEY=replace-me
# Fully offline local demo (no external calls, canned responses):
# ATOMS_MODEL_PROVIDER=demo

# --- Preview gateway -------------------------------------------------------
# Public origin that reverse-proxies /p/* to the API; normally just repeat
# ATOMS_SITE_ADDRESS.
ATOMS_PREVIEW_PUBLIC_ORIGIN=http://203.0.113.10

# --- Tuning (optional) ------------------------------------------------------
# Idle window before the worker stops an unvisited preview dev server.
# ATOMS_PREVIEW_IDLE_MS=600000
# Worker queue poll interval.
# ATOMS_WORKER_POLL_MS=300
