{
	# Let's Encrypt uses this for expiry notices; point it at a real inbox.
	email {$ACME_EMAIL}
}

{$ATOMS_DOMAIN} {
	encode zstd gzip

	route {
		# Run event streams are SSE: disable buffering so events arrive while
		# the agent is still working.
		@sse path /api/runs/*/events/stream*
		reverse_proxy @sse atoms:3000 {
			flush_interval -1
		}

		# Builder API lives behind the /api prefix; strip it before proxying.
		handle_path /api/* {
			reverse_proxy atoms:3000
		}

		# Public preview gateway and published apps are served by the API.
		handle /p/* {
			reverse_proxy atoms:3000
		}

		handle /published/* {
			reverse_proxy atoms:3000
		}

		# Everything else is the static builder SPA.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
