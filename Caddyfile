{
	# Let's Encrypt uses this for expiry notices; point it at a real inbox.
	email {$ACME_EMAIL}
}

{$ATOMS_DOMAIN} {
	encode zstd gzip

	route {
		# Run event streams are SSE: disable buffering so events arrive while
		# the agent is still working. The API registers these routes without
		# the /api prefix, so it must be stripped here too.
		@sse path /api/runs/*/events/stream*
		handle @sse {
			uri strip_prefix /api
			reverse_proxy atoms:3000 {
				flush_interval -1
			}
		}

		# Liveness probe straight to the API (otherwise it hits the SPA
		# fallback and returns index.html with a 200).
		handle /health {
			reverse_proxy atoms:3000
		}

		# Builder API lives behind the /api prefix; strip it before proxying.
		handle_path /api/* {
			reverse_proxy atoms:3000
		}

		# Public preview gateway and published apps are served by the API.
		handle /p/* {
			reverse_proxy atoms:3000
		}

		handle /published/* {
			reverse_proxy atoms:3000
		}

		# Everything else is the static builder SPA.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
